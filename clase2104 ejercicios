class Usuario:
  def __init__ (self, nombre):
    self ._nombre = nombre

    @property
    def nombre (self):
        return self._nombre

    @nombre.setter
    def nombre_nuevo (self, nombre2):
        if len (nombre2) == 0:
            raise ValueError ("El nombre no puede ser 0")
        self ._nombre = nombre2



u = Usuario ("Tami")
